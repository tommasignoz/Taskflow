# ==============================================================================
# TaskFlow - Esempio Configurazione Globale (.env.example)
# Copia questo file in .env: cp .env.example .env
# ==============================================================================

# --- DATABASE POSTGRESQL (DOCKER) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# URL di connessione per strumenti locali su host (Drizzle Kit, Studio, migrazioni)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow

# --- BACKEND (FASTIFY + NODEJS SU DOCKER) ---
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0
NODE_ENV=development

# --- FRONTEND (REACT + VITE SU HOST) ---
FRONTEND_PORT=5173
FRONTEND_HOST=0.0.0.0
VITE_API_BASE_URL=/api
